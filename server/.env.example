# Node Environment
NODE_ENV=development # or production 
PORT=5000

# MongoDB
MONGO_URI="<your_mongodb_uri_here>"

# JWT
JWT_SECRET="<>your_jwt_secret_here>"
JWT_EXPIRE=30d

# Email Configuration
EMAIL_HOST="<your_email_host_here>"
EMAIL_PORT=587 #recommended for TLS
EMAIL_SECURE=false # set to true if using SSL
EMAIL_USER="<your_email_user_here>"
EMAIL_PASSWORD="<your_email_password_here>" # basically app password and not your email password
EMAIL_FROM_NAME=Sugoi
EMAIL_FROM_ADDRESS=<your_email_user_here> # should be same as EMAIL_USER

# Redis (optional, for distributed rate limiting)
REDIS_URL=

# Cache Control
DISABLE_CACHE=false # set to true to disable cache control headers (not recommended to set to true in production)

# Security
CORS_ORIGIN="<your_frontend_url_here>" # e.g., http://localhost:3000 or https://yourdomain.com
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX=100 # maximum number of requests allowed in the window

TURNSTILE_SECRET_KEY="<your_turnstile_secret_key_here>" # get your site key from Cloudflare
TURNSTILE_ENABLED=true # not recommended to set to false in production, as it will disable the Turnstile verification
